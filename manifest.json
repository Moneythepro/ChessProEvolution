{
  "name": "Chess Pro Evolution",
  "short_name": "Chess Evolution",
  "description": "A next-generation chess experience with smooth animations, immersive audio, offline mode, online multiplayer, AI opponent, tutorials, and full PWA capabilities.",
  "id": "com.chesspro.evolution",
  "start_url": "https://chess-pro-evolution.vercel.app/?source=pwa",
  "scope": "https://chess-pro-evolution.vercel.app/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#1e1e2f",
  "theme_color": "#4f46e5",
  "categories": ["games", "board", "entertainment", "puzzle", "multiplayer"],
  "dir": "ltr",
  "lang": "en",
  "prefer_related_applications": false,
  "related_applications": [],
  "protocol_handlers": [
    {
      "protocol": "web+chess",
      "url": "https://chess-pro-evolution.vercel.app/?match=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Play vs Computer",
      "short_name": "Computer",
      "description": "Start a quick chess match against AI",
      "url": "/?mode=computer",
      "icons": [{ "src": "favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Play Online",
      "short_name": "Online",
      "description": "Challenge a friend or random player online",
      "url": "/?mode=online",
      "icons": [{ "src": "favicon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Learn Chess",
      "short_name": "Learn",
      "description": "Open the chess tutorial and tips section",
      "url": "/tutorial",
      "icons": [{ "src": "favicon.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screen1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshots/screen2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "icons": [
    {
      "src": "favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred"
}
